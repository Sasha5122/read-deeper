# OpenAI (platform.openai.com -> API keys) — powers all AI features
OPENAI_API_KEY=

# Anthropic (legacy, unused when OpenAI is configured)
ANTHROPIC_API_KEY=

# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=

# Model tiers (dispatcher/lookup = cheapest, thread = workhorse, document = heavy)
MODEL_DISPATCHER=gpt-5-nano
MODEL_LOOKUP=gpt-5-nano
MODEL_THREAD=gpt-5-mini
MODEL_DOCUMENT=gpt-5
MODEL_EMBEDDING=text-embedding-3-small

# Limits
FREE_THREADS_PER_DAY=5

# Base URL of the deployed app (used for Stripe redirects)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Office->PDF converter (docker run -d -p 3010:3000 gotenberg/gotenberg:8)
GOTENBERG_URL=http://127.0.0.1:3010
